  "lines": [
    {"screen": "title", "keys": [], "caption": "This is a tour of the second part of pull request 33, which copies your reply and fix rules into the repo.", "src": "9de24e72cbe2"},
    {"screen": "title", "keys": ["p1", "p2", "p3"], "caption": "It has three parts: what this PR adds, how it was built and verified, and what comes later.", "src": "f51d870c1af7"},
    {"screen": "adds", "keys": [], "caption": "Part 1. What this PR adds.", "src": "d66557f5d344"},
    {"screen": "flow", "keys": ["1"], "caption": "Your rules lived only in your own Claude file, on your machine.", "src": "22f0edb7d927"},
    {"screen": "flow", "keys": ["2"], "caption": "Now two sections of them are in the repo's Claude file.", "src": "a8d55bf77b4c"},
    {"screen": "flow", "keys": ["3"], "caption": "Every web session reads that file when it starts.", "src": "65a28be4cf67"},
    {"screen": "flow", "keys": ["4"], "caption": "So when a session needs you, you can answer with one number or letter.", "src": "197092570e6d"},
    {"screen": "bigpic", "keys": ["note"], "caption": "The wording comes from closed pull request 27, plus one rule the issue added.", "src": "2a0501d4cb4f"},
    {"screen": "rules", "keys": ["r1", "r2"], "caption": "Questions for you come as short numbered options, and routine steps are never among them.", "src": "e19209d30942"},
    {"screen": "rules", "keys": ["r6"], "caption": "A change the issue doesn't cover becomes a new issue, not part of the pull request.", "src": "39e7ba1424a9"},
    {"screen": "rules", "keys": ["r7"], "caption": "And fixes follow existing code, preferring one shared fix over many small ones.", "src": "968ced20622d"},
    {"screen": "files", "keys": ["fold"], "caption": "At your request, this rides along in the pull request for issue 23.", "src": "de0aebef296a"},
    {"screen": "verified", "keys": [], "caption": "Part 2. How it was built and verified.", "src": "1acba3394b16"},
    {"screen": "checks", "keys": ["c1"], "caption": "The text was compared with the commit it came from, and matches.", "src": "195d0864de7d"},
    {"screen": "checks", "keys": ["c3"], "caption": "Whether sessions follow it can only be seen in a later session.", "src": "d3696e7f271f"},
    {"screen": "later", "keys": [], "caption": "Part 3. What comes later.", "src": "f61f5de96057"},
    {"screen": "next", "keys": ["1"], "caption": "The next web session after the merge is the first to start with these rules.", "src": "73393f30162a"},
    {"screen": "title", "keys": [], "caption": "In short: web sessions now report to you the way you asked.", "src": "9de24e72cbe2"}
  ],
